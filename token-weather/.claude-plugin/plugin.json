{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "token-weather",
  "version": "0.2.2",
  "displayName": "Token Weather",
  "description": "A live forecast of the context window above the prompt, with a prompt-cache countdown",
  "types": "./types/index.d.ts",
  "userConfig": {
    "cacheTtl": {
      "type": "string",
      "title": "Prompt cache lifetime",
      "description": "auto (default) detects the cache lifetime from Claude's responses. Set 5m or 1h to override.",
      "options": [
        "auto",
        "5m",
        "1h"
      ],
      "default": "auto"
    }
  },
  "license": "MIT",
  "author": {
    "name": "Alex",
    "email": "alex@rzem.com",
    "url": "https://github.com/rzem-ai"
  },
  "homepage": "https://github.com/rzem-ai/claude-code-mods/tree/main/token-weather",
  "repository": "https://github.com/rzem-ai/claude-code-mods",
  "documentationUrl": "https://github.com/rzem-ai/claude-code-mods/blob/main/token-weather/README.md",
  "supportUrl": "https://github.com/rzem-ai/claude-code-mods/issues",
  "keywords": [
    "context",
    "prompt-cache",
    "tokens",
    "band"
  ]
}
