{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "inbox-alerts",
  "version": "0.1.0",
  "displayName": "Inbox Alerts",
  "description": "Gmail, Slack and Calendar alerts inside Claude Code: toasts, a status count, and an Alerts pane",
  "types": "./types/index.d.ts",
  "userConfig": {
    "email": {
      "type": "string",
      "title": "Your email",
      "description": "Your Gmail address, so your own sent mail is not an alert",
      "default": ""
    },
    "slackUserId": {
      "type": "string",
      "title": "Your Slack user ID",
      "description": "Your Slack member ID (U...), used to find mentions and DMs",
      "default": ""
    }
  },
  "license": "MIT",
  "author": {
    "name": "Alex",
    "email": "alex@rzem.com",
    "url": "https://github.com/rzem-ai"
  },
  "homepage": "https://github.com/rzem-ai/claude-code-mods/tree/main/inbox-alerts",
  "repository": "https://github.com/rzem-ai/claude-code-mods",
  "documentationUrl": "https://github.com/rzem-ai/claude-code-mods/blob/main/inbox-alerts/README.md",
  "supportUrl": "https://github.com/rzem-ai/claude-code-mods/issues",
  "icon": "./.claude-plugin/icon.png",
  "keywords": [
    "gmail",
    "slack",
    "calendar",
    "notifications"
  ]
}
